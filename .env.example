# ==============================================================
# CodeSentinel AI - Environment Variables
# ==============================================================
# Copy this file to .env and fill in your values:
#   copy .env.example .env
#
# NEVER commit .env to git (it contains secrets)
# ==============================================================

# ---- PostgreSQL ----
POSTGRES_USER=codesentinel
POSTGRES_PASSWORD=codesentinel_secret_2024
POSTGRES_AUTH_DB=auth_db
POSTGRES_INGESTION_DB=ingestion_db
POSTGRES_PARSER_DB=parser_db

# ---- Redis ----
REDIS_PASSWORD=redis_secret_2024

# ---- Neo4j ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_secret_2024

# ---- JWT ----
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=Y29kZXNlbnRpbmVsLWFpLXN1cGVyLXNlY3JldC1rZXktZm9yLWp3dC10b2tlbi1nZW5lcmF0aW9uLTIwMjQ=
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ---- Ollama ----
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ---- Service Ports ----
CONFIG_SERVER_PORT=8888
DISCOVERY_SERVER_PORT=8761
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
INGESTION_SERVICE_PORT=8082
PARSER_SERVICE_PORT=8083
AI_SERVICE_PORT=8090
GRAPH_SERVICE_PORT=8091
NOTIFICATION_SERVICE_PORT=8092

# ---- SonarQube ----
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=your_sonar_token_here